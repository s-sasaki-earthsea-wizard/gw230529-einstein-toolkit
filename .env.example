# GW230529 BH-NS Einstein Toolkit -- environment settings template
# Copy this file to `.env` and adjust it for the local machine.
# `.env` is gitignored.

# ============================================================
# Simulation output directory
# ============================================================
# Host directory for diagnostic output (HDF5 evolution data, ASCII statistics,
# horizon metadata and so on). I/O is heavy, so a **local SSD** is strongly
# recommended; avoid NAS mounts.
# Mounted at /home/etuser/simulations inside the container.
SIM_OUTPUT_DIR=${HOME}/gw230529-output

# ============================================================
# Dedicated checkpoint directory
# ============================================================
# Keeps checkpoint (.h5) files separate from diagnostic output.
# The gallery parfile uses ``IO::checkpoint_dir = "../CHECKPOINTS"`` relative
# to the run cwd; Phase 2 adjusts the parfile so that this resolves under
# /home/etuser/checkpoints.
# Cloud (spot) runs raise the checkpoint frequency to every 0.5-1.0 h.
SIM_CHECKPOINT_DIR=${HOME}/gw230529-checkpoints

# ============================================================
# Jupyter Lab port
# ============================================================
# Host-side published port. 8889 so this can run alongside the
# GW150914 container (8888).
JUPYTER_PORT=8889

# ============================================================
# CPU and memory allocated to the container
# ============================================================
# Assumes all 16 cores go to the simulation. Reduce when working in parallel
# with other tasks. Estimated memory at dx=28 (0.686x) is around 45 GB,
# extrapolated as the official 140 GB times f^3 -- still to be measured.
CONTAINER_CPUSET=0-15
CONTAINER_MEM_LIMIT=80g

# ============================================================
# Shared memory size
# ============================================================
# Used by MPICH for inter-process communication. The 64MB default is not
# enough, so this is raised to a few GB.
CONTAINER_SHM_SIZE=4gb

# ============================================================
# Docker build parameters
# ============================================================
# UID/GID of the in-container user (etuser). Matching the host keeps
# bind-mount permissions consistent. Usually the host's `id -u` / `id -g`
# (1000/1000 on a typical Linux desktop).
USER_UID=1000
USER_GID=1000

# make parallelism for the Cactus build. Compile-time memory use scales
# roughly with file count times parallelism. Lower it if gcc gets OOM killed.
MAKE_PARALLEL=8

# ============================================================
# Simulation parallelism (used from Phase 2 onwards)
# ============================================================
# MPI process count and OpenMP threads per process when running cactus_sim.
# SIM_MPI_PROCS x SIM_OMP_THREADS must not exceed the physical core count.
#
# The official reference run is np=256 x OMP=1, pure MPI (COSMA8), and the
# cloud plan (c7a.48xlarge, 192 cores) follows the same shape. Verifying np>=2
# locally -- especially HDF5 checkpoint write/restart -- is therefore the
# Phase 2 go/no-go item.
#
# Note: the GW150914 project recorded HDF5 POSIX lock collisions and OOM kills
# at np>=2 and settled on np=1. Both symptoms are explained by a mixed
# Open MPI / MPICH link in that image, which this project's Dockerfile now
# prevents and asserts against at build time. Re-measure rather than assuming
# the old np=1 constraint still applies.
#
# The values below only seed the container environment. Parallelism for
# make-driven runs comes from sim.mk (added in Phase 2) or a command-line override.
SIM_MPI_PROCS=2
SIM_OMP_THREADS=8
